{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coldguardian command outcome",
  "type": "object",
  "required": ["command", "status", "exit_code"],
  "additionalProperties": false,
  "properties": {
    "host_watch": {
      "type": "object", "additionalProperties": false, "required": ["scope", "status"],
      "properties": {"scope": {"const": "this machine only"}, "status": {"enum": ["ok", "incomplete"]}}
    },
    "freshness": {
      "type": "object", "required": ["quick", "deep", "feeds"],
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["last_success", "status"],
        "properties": {
          "last_success": {"type": ["integer", "null"]},
          "status": {"enum": ["fresh", "stale", "missing", "unscheduled"]}
        }
      }
    },
    "schema_version": {"type": "integer", "const": 1},
    "command": {"enum": ["setup", "uninstall", "feeds update", "status"]},
    "status": {"enum": ["ok", "declined", "incomplete", "canceled", "failed"]},
    "exit_code": {"type": "integer", "enum": [0, 2]}
  },
  "oneOf": [
    {
      "properties": {"command": {"const": "setup"}},
      "required": ["schema_version"],
      "oneOf": [
        {"properties": {"status": {"enum": ["ok", "declined"]}, "exit_code": {"const": 0}}},
        {"properties": {"status": {"enum": ["incomplete", "canceled", "failed"]}, "exit_code": {"const": 2}}}
      ]
    },
    {
      "properties": {"command": {"enum": ["uninstall", "feeds update", "status"]}},
      "oneOf": [
        {"properties": {"status": {"const": "ok"}, "exit_code": {"const": 0}}},
        {"properties": {"command": {"const": "status"}, "status": {"const": "incomplete"}, "exit_code": {"const": 2}}},
        {"properties": {"command": {"const": "uninstall"}, "status": {"const": "canceled"}, "exit_code": {"const": 2}}},
        {"properties": {"status": {"const": "failed"}, "exit_code": {"const": 2}}}
      ]
    }
  ]
}
