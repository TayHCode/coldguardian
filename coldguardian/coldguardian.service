[Unit]
Description=Local homelab network defense report (alert only)

[Service]
Type=oneshot
ExecStart={python} -m coldguardian.cli --{profile} --config "%h/.config/coldguardian/config.json"
SuccessExitStatus=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/coldguardian
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
Nice=10
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
